rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return signedIn()
        && request.auth.token.email == "admin@missio-lite.com";
    }

    function hasSuperAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.globalRole == "super_admin";
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || hasSuperAdminProfile();
    }

    function isBusinessMember(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function memberRole(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role;
    }

    function isBusinessOwnerOrManager(businessId) {
      return isBusinessMember(businessId)
        && memberRole(businessId) in ["owner", "boss", "manager"];
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isSuperAdmin());

      allow create, update: if signedIn()
        && (request.auth.uid == userId || isSuperAdmin());

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if signedIn()
        && (isSuperAdmin() || isBusinessMember(businessId));

      allow create, update: if isSuperAdmin();

      allow delete: if false;

      match /usernames/{username} {
        allow get: if true;

        allow list: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow create, update: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if signedIn()
          && (isSuperAdmin() || isBusinessMember(businessId));

        allow create, update: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if signedIn()
          && (isSuperAdmin() || isBusinessMember(businessId));

        allow create, update: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow delete: if false;
      }

      match /locationChecks/{checkId} {
        allow read: if signedIn()
          && (isSuperAdmin() || isBusinessMember(businessId));

        allow create, update: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow delete: if false;
      }

      match /passwordResetRequests/{requestId} {
        allow create: if true;

        allow read: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow update: if signedIn()
          && (isSuperAdmin() || isBusinessOwnerOrManager(businessId));

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
